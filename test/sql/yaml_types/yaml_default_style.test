# name: test/sql/yaml_types/yaml_default_style.test
# description: Output styles are per-call and SQL cannot change process defaults
# group: [yaml_types]

require yaml

query I
SELECT count(*) FROM duckdb_functions() WHERE function_name IN
('yaml_set_default_style', 'yaml_set_max_input_size', 'yaml_set_max_nesting_depth', 'yaml_set_max_expansion_nodes');
----
0

query T
SELECT yaml_get_default_style();
----
flow

query I
SELECT contains(format_yaml({'name':'John', 'items':[1,2,3]}, style := 'block'), chr(10));
----
true

query I
SELECT contains(format_yaml({'name':'John', 'items':[1,2,3]}, style := 'flow'), chr(10));
----
false

query I
SELECT contains(value_to_yaml({'name':'John', 'items':[1,2,3]})::VARCHAR, chr(10));
----
false

query T
SELECT yaml_get_default_style();
----
flow

statement error
SELECT format_yaml({'a':1}, style := 'invalid');
----
Invalid YAML style

query I
SELECT contains(format_yaml({'a':1, 'b':2}, style := 'BLOCK'), chr(10));
----
true
