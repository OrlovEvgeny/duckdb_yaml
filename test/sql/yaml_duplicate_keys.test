# name: test/sql/yaml_duplicate_keys.test
# description: Reject ambiguous mapping keys consistently
# group: [yaml]

require yaml

statement error
SELECT yaml_to_json('{a: 1, a: 2}');
----
Duplicate key

statement error
SELECT * FROM read_yaml('test/yaml/duplicate_keys.yaml');
----
Duplicate key

statement error
SELECT COUNT(*) FROM read_yaml('test/yaml/duplicate_keys.yaml');
----
Duplicate key

statement error
SELECT * FROM parse_yaml('Name: 1
name: 2');
----
Duplicate key
