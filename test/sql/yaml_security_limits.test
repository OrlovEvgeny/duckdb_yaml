# name: test/sql/yaml_security_limits.test
# description: DoS hardening - bound YAML nesting depth and alias/anchor expansion (GHSA-h5hw-g5m6-vmjj)
# group: [yaml]

require yaml

# ============================================================================
# Limits can be inspected but cannot be changed by SQL users
# ============================================================================

query III
SELECT yaml_get_max_expansion_nodes() > 0,
       yaml_get_max_nesting_depth() > 0,
       yaml_get_max_input_size() > 0;
----
true	true	true

# ============================================================================
# Positive: ordinary and moderately-deep documents still parse (no false
# rejections). Legitimate anchors/aliases are NOT rejected.
# ============================================================================

query I
SELECT yaml_to_json('a: 1
b: [1, 2, 3]
c: {x: 1, y: 2}');
----
{"a":1,"b":[1,2,3],"c":{"x":1,"y":2}}

# 20 levels of nesting parses fine under the default depth cap
query I
SELECT yaml_to_json(yaml(repeat('[', 20) || 'z' || repeat(']', 20))) IS NOT NULL;
----
true

# A legitimate (non-exponential) anchor/alias reference is preserved, not rejected
query I
SELECT yaml_to_json('shared: &x [1, 2, 3]
a: *x
b: *x') IS NOT NULL;
----
true

# ============================================================================
# Parser and traversal depth guards use fixed production limits.
# ============================================================================

statement error
SELECT yaml_to_json(yaml(repeat('[', 1001) || 'z' || repeat(']', 1001)));
----
Invalid YAML

# The extraction/unnest path navigator recurses once per path component, so an
# over-long attacker-supplied path is bounded too.
statement error
SELECT yaml_extract('a: 1', '$' || repeat('.a', 1001));
----
nesting

# Ordinary nesting remains valid
query I
SELECT yaml_to_json(yaml(repeat('[', 20) || 'z' || repeat(']', 20))) IS NOT NULL;
----
true

# ============================================================================
# Repeated aliases exceed the output/input ratio before materialization.
# ============================================================================

statement error
SELECT yaml_to_json(yaml('defs:
  - &a0 [z, z, z, z]
  - &a1 [*a0, *a0, *a0, *a0]
  - &a2 [*a1, *a1, *a1, *a1]
  - &a3 [*a2, *a2, *a2, *a2]
  - &a4 [*a3, *a3, *a3, *a3]
  - &a5 [*a4, *a4, *a4, *a4]
  - &a6 [*a5, *a5, *a5, *a5]
  - &a7 [*a6, *a6, *a6, *a6]
  - &a8 [*a7, *a7, *a7, *a7]
root: *a8'));
----
expansion

# The same budget guards the other functions that walk the whole node tree
# with their own recursion (yaml_structure / yaml_contains / yaml_merge_patch).
statement error
SELECT yaml_structure('defs:
  - &a0 [z, z, z, z]
  - &a1 [*a0, *a0, *a0, *a0]
  - &a2 [*a1, *a1, *a1, *a1]
  - &a3 [*a2, *a2, *a2, *a2]
  - &a4 [*a3, *a3, *a3, *a3]
  - &a5 [*a4, *a4, *a4, *a4]
  - &a6 [*a5, *a5, *a5, *a5]
  - &a7 [*a6, *a6, *a6, *a6]
  - &a8 [*a7, *a7, *a7, *a7]
root: *a8');
----
expansion

statement error
SELECT yaml_contains('defs:
  - &a0 [z, z, z, z]
  - &a1 [*a0, *a0, *a0, *a0]
  - &a2 [*a1, *a1, *a1, *a1]
  - &a3 [*a2, *a2, *a2, *a2]
  - &a4 [*a3, *a3, *a3, *a3]
  - &a5 [*a4, *a4, *a4, *a4]
  - &a6 [*a5, *a5, *a5, *a5]
  - &a7 [*a6, *a6, *a6, *a6]
  - &a8 [*a7, *a7, *a7, *a7]
root: *a8', 'x: 1');
----
expansion

statement error
SELECT yaml_merge_patch('defs:
  - &a0 [z, z, z, z]
  - &a1 [*a0, *a0, *a0, *a0]
  - &a2 [*a1, *a1, *a1, *a1]
  - &a3 [*a2, *a2, *a2, *a2]
  - &a4 [*a3, *a3, *a3, *a3]
  - &a5 [*a4, *a4, *a4, *a4]
  - &a6 [*a5, *a5, *a5, *a5]
  - &a7 [*a6, *a6, *a6, *a6]
  - &a8 [*a7, *a7, *a7, *a7]
root: *a8', 'x: 1');
----
expansion

# Ordinary alias reuse remains valid.
query I
SELECT yaml_to_json('shared: &x [1, 2, 3]
a: *x
b: *x
c: *x') IS NOT NULL;
----
true

# ============================================================================
# Input-size cap on the scalar functions (previously only file readers were
# capped; scalar string input was not - finding #3).
# ============================================================================

statement error
SELECT from_yaml(repeat('a: 1
', 4000000), {'a': 0});
----
maximum allowed size

query I
SELECT from_yaml('a: 1', {'a': 0}) IS NOT NULL;
----
true
